; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Quill"
run/main_scene="uid://b5v1xwqoidprj"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://dhnc0cgcvffax"

[autoload]

SignalBus="*uid://b5t4wg6pk5yg"
PlayerStatus="*uid://cp1p0gyqjag27"
HitstopManager="*uid://c6lmcu163udnf"
Commands="*uid://dy7qvudcb6x52"

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://resources/": "red",
"res://scenes/": "teal",
"res://scripts/": "orange",
"res://scripts/resource_classes/": "red",
"res://scripts/state_machine/": "pink",
"res://scripts/states/": "pink"
}

[global_group]

Player="For only players, used for enemy targeting"

